# DeepMem Agent — Environment Variables
# Copy this file to .env and fill in your API keys.

# ──────────────────────────────────────────────
# LLM Provider
# ──────────────────────────────────────────────
# Options: dashscope (default), openai, or any OpenAI-compatible endpoint
LLM_PROVIDER=dashscope

# DashScope (Alibaba Cloud / Qwen)
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# OpenAI (if using OpenAI instead)
# OPENAI_API_KEY=sk-your-openai-api-key

# Custom OpenAI-compatible endpoint (Ollama, vLLM, etc.)
# LLM_BASE_URL=http://localhost:11434/v1

# Model name (default: qwen-flash for DashScope, gpt-4o-mini for OpenAI)
# LLM_MODEL=qwen-flash

# ──────────────────────────────────────────────
# Embedding
# ──────────────────────────────────────────────
# If different from LLM provider, override here:
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=text-embedding-v3
